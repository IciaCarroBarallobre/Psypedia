# Local development settings for compose.dev.yaml.
# Required before running Docker Compose: copy this template to .env.

# ------ Presentation and Backend Layers ----
FRONTEND_PORT=5173
BACKEND_PORT=5000

CHAT_PROVIDER=ollama # Response provider: ollama/mock.

#------ OLLAMA CONFIGURATION ------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b # Prioritize response quality over local CPU speed.

OLLAMA_TIMEOUT=120
OLLAMA_IMAGE=ollama/ollama:latest
